# Copia este archivo como ".env" (en la raíz del repo) y completa los valores. NUNCA subas .env a GitHub.
# Lo leen: docker compose (local) y los 2 microservicios cuando los corres con ./mvnw spring-boot:run

# AWS Academy (Learner Lab -> AWS Details -> AWS CLI -> Show). Cambian en CADA sesión.
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Solo para docker compose local (MySQL en contenedor)
DB_PASSWORD=clave-local-123

# EXTRA OPCIONAL: vacío = desactivado
GATEWAY_SECRET=
